# ===== 优学院签到模块配置 =====
# adapters: mock | youxue
#   mock   —— 本地模拟，无需任何账号，装上就能跑通全流程（默认）
#   youxue —— 真实自动化：App 自己轮询优学院并提交签到
EXPO_PUBLIC_YOUXUE_ADAPTER=mock

# 租户标识（决定域名与适配器）：dgut = 东莞理工学院
EXPO_PUBLIC_YOUXUE_TENANT=dgut

# ===== 以下仅在 youxue 适配器且用账号密码登录时才需要 =====
EXPO_PUBLIC_DGUT_LMS_HOST=https://lms.dgut.edu.cn
EXPO_PUBLIC_DGUT_APP_HOST=https://application.dgut.edu.cn
EXPO_PUBLIC_DGUT_AUTH_HOST=https://auth.dgut.edu.cn

# ===== 签到功能授权（白名单）=====
# 名单 JSON 的 HTTPS 直链（对象存储/Gist/私有 CDN 均可）
# 留空时：开发模式下自动旁路；生产构建视为未授权。
# 名单格式与管理方式见 docs/license-system.md
EXPO_PUBLIC_LICENSE_URL=

# ══════════════════════════════════════════════════════════════════
# ★ 自建必看：下面这几个值**故意留空/占位** —— 公开仓库里没有真实值。
#
# 做法：把真实值写进 `.env.local`（已在 .gitignore 里，不会入库），
#       本文件只当模板。
# ══════════════════════════════════════════════════════════════════

# 内置便利万能码（不设 → 占位符 CHANGEMEPLEASE，不能用）
#   ⚠️ 只用**纯字母数字**：判定链上输入侧会丢掉横线/空格/下划线，
#      带下划线的占位符会永远匹配不上（踩过）。
# EXPO_PUBLIC_MASTER_CODE=你自己想一个

# 手机端默认服务器地址（不设 → 装好后在设置页里手填）
# EXPO_PUBLIC_SERVER_BASE=http://你的服务器:8787

# 服务端默认万能码（不设 → CHANGE_ME 占位符，登录不进去）
# LIFEKIT_MASTER_CODE=你自己想一个

# 部署脚本要连的服务器（部署/运维类脚本必需）
# LIFEKIT_HOST=你的服务器IP

# 管理后台口令
# LIFEKIT_ADMIN_PASSWORD=你的口令
